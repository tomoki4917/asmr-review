# 本番・OGP の canonical 用（省略時は http://localhost:3000）
NEXT_PUBLIC_SITE_URL=https://example.com

# /admin の簡易ゲート（NEXT_PUBLIC はビルド成果物に埋め込まれる。本番では API 認証等への置き換え推奨）
NEXT_PUBLIC_ADMIN_PASSWORD=

# お問い合わせ：FormSubmit の送信先（未設定時はフォームを表示しません）
NEXT_PUBLIC_CONTACT_TO_EMAIL=

# 忍者AdMax：ダッシュボードのタグ取得で得た script の src URL をそのまま
NEXT_PUBLIC_ADMAX_SCRIPT_INLINE=https://adm.shinobi.jp/s/YOUR_INLINE_PLACEMENT_ID
NEXT_PUBLIC_ADMAX_SCRIPT_HOME_TOP=https://adm.shinobi.jp/s/YOUR_TOP_PLACEMENT_ID
# 省略時は NEXT_PUBLIC_ADMAX_SCRIPT_INLINE と同じ
# NEXT_PUBLIC_ADMAX_SCRIPT_MOBILE=

# ads.txt（public/ads.txt）はクローラ向けの公開ファイルのため env ではなくファイルで管理。第2フィールドを管理画面のパブリッシャーIDに合わせてください。

# Google AI（API Route のみ。ブラウザに出さないこと）
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# 将来: Whisper 等（サーバー専用。OPENAI_API_KEY は NEXT_PUBLIC にしない）
# OPENAI_API_KEY=
# WHISPER_MODEL=whisper-1

# Giscus（https://giscus.app で repo・category ID を取得）
# すべて埋めるとビルド時にバンドルへ埋め込まれます。未設定なら本番で public/giscus-config.json を配置しても可（.gitignore 推奨）。
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
