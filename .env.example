# 本番・OGP の canonical 用（省略時は http://localhost:3000）
NEXT_PUBLIC_SITE_URL=https://example.com

# 投稿は /admin（パスワード保護。サイト上にリンクは出しません）。

# Google AI Studio などで取得（診断モーダル用）
GEMINI_API_KEY=

# 省略時は gemini-1.5-flash
# GEMINI_MODEL=gemini-2.0-flash

# お問い合わせの送信先メール（省略時は vca.reviewlabo@gmail.com / FormSubmit）
# NEXT_PUBLIC_CONTACT_TO_EMAIL=

# 忍者AdMax スマホ用 MPU タグ（768px 未満。省略時はインライン共通タグと同じ）
# NEXT_PUBLIC_ADMAX_SCRIPT_MOBILE=

# Giscus（https://giscus.app で repo・category ID を取得）
# すべて埋めるとビルド時にバンドルへ埋め込まれます。未設定なら本番で public/giscus-config.json を配置しても可。
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
