# 本番・OGP の canonical 用（省略時は http://localhost:3000）
NEXT_PUBLIC_SITE_URL=https://example.com

# ヘッダー区分切替（全年齢 ⇄ R18）。全年齢 URL 省略時は /all-ages/
# NEXT_PUBLIC_ALL_AGES_SITE_URL=https://all-ages.example.com
# NEXT_PUBLIC_R18_SITE_URL=https://example.com

# 記事に coverImage がないときの OGP/Twitter 用画像（http(s) または /path。省略時は /ogp-fallback.png）
# NEXT_PUBLIC_OGP_FALLBACK_IMAGE=/ogp-fallback.png

# Google Analytics 4（@next/third-parties の GoogleAnalytics。未設定時はタグを出しません）
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# /admin の簡易ゲート（NEXT_PUBLIC はビルド成果物に埋め込まれる。本番では API 認証等への置き換え推奨）
NEXT_PUBLIC_ADMIN_PASSWORD=

# お問い合わせ：FormSubmit の送信先（未設定時は src/lib/contact-destination-email.ts の既定を使用）
# NEXT_PUBLIC_CONTACT_TO_EMAIL=

# 忍者AdMax（省略時はコード内の既定 URL が使われます。別枠に差し替えるときだけ設定）
# NEXT_PUBLIC_ADMAX_SCRIPT_INLINE=
# NEXT_PUBLIC_ADMAX_SCRIPT_HOME_TOP=
# NEXT_PUBLIC_ADMAX_SCRIPT_MOBILE=

# ads.txt（public/ads.txt）はクローラ向けの静的ファイル。パブリッシャーIDを変えたらこのファイルも合わせてください。

# 予約投稿（goLiveAt）
# - `npm run build`（静的 out）ではビルド時刻で判定。一覧・サイトマップは公開済みのみ。
# - `npm run dev` / `npm run start`（LAN 含む）では既定で goLive 前も一覧・本文を表示（検証用）。
#   Docker 等で npm_lifecycle_event が無いときだけ true にする。
# REVIEW_PREVIEW_SERVER=true
# dev / next start でも予約と同じ除外を試すとき:
# REVIEW_RESPECT_GO_LIVE=true
# 任意環境で goLiveAt を無視して全件表示（本番ビルドでは通常未設定）。
# REVIEW_IGNORE_GO_LIVE=true

# Google AI（API Route のみ。ブラウザに出さないこと）
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# 将来: Whisper 等（サーバー専用。OPENAI_API_KEY は NEXT_PUBLIC にしない）
# OPENAI_API_KEY=
# WHISPER_MODEL=whisper-1
