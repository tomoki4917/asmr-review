# copy → .env（Git に含めない）
GEMINI_API_KEY=your_api_key_here

# 作品ごとに変更（省略時は analysis-dir から自動生成）
# HYPNOSIS_WHISPER_FILE=C:\解析\作品A\whisper_output.txt
# HYPNOSIS_LIBROSA_FILE=C:\解析\作品A\librosa_output.txt

# GEMINI_EVAL_MODEL=gemini-2.5-flash
# GEMINI_WRITER_MODEL=gemini-2.5-flash

# 採点・執筆はリポジトリ正本のみ（デスクトップ .txt マニュアルは使わない）
# HYPNOSIS_EVAL_SYSTEM=scripts/gemini-hypnosis-review/eval_system_repo.md
# HYPNOSIS_WRITER_SYSTEM=scripts/gemini-hypnosis-review/writer_system_amatori.md
