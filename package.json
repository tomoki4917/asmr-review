{
  "name": "asmr-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true}); console.log('removed .next')\"",
    "validate:content-data": "node scripts/validate-content-data.mjs",
    "validate:dlsite-prices": "node scripts/validate-dlsite-prices.mjs",
    "validate:quick-guide": "node scripts/scan-duplicate-impression.mjs",
    "sync:content-assets": "node scripts/sync-content-assets.mjs",
    "prebuild": "npm run validate:content-data && npm run validate:dlsite-prices && npm run validate:quick-guide && npm run sync:content-assets",
    "dev": "npm run sync:content-assets && next dev",
    "dev:lan": "npm run sync:content-assets && next dev -H 0.0.0.0",
    "build": "next build",
    "out": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "next lint",
    "update-prices": "node scripts/update-prices.js",
    "update-prices:stale": "node scripts/update-prices.js --stale-sale-ended",
    "update-price:one": "node scripts/fetch-one-price.mjs",
    "sync-review-sale-from-dlsite": "node scripts/sync-review-sale-from-dlsite.mjs",
    "audit:reviews-dlsite": "node scripts/audit-reviews-dlsite.mjs",
    "fetch-dlsite-reviews:one": "node scripts/fetch-dlsite-user-reviews.mjs",
    "review:create-genkami": "node scripts/create-hypnosis-review-shell.mjs",
    "review:audit-kansei": "node scripts/audit-review-kansei.mjs",
    "review:validate-prose": "py -3 scripts/gemini-hypnosis-review/review_prose_rules.py",
    "review:audit-scenario": "node scripts/audit-review-scenario.mjs",
    "review:score-doujin-graph": "node scripts/score-doujin-graph-features.mjs",
    "review:audit-doujin-transcript": "node scripts/audit-doujin-transcript.mjs",
    "review:compare-doujin-graph": "node scripts/compare-doujin-graph-scores.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.15.1",
    "cheerio": "^1.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
