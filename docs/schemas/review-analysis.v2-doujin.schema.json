{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asmr-review.local/schemas/review-analysis.v2-doujin.schema.json",
  "title": "レビュー — 分析データ（v2・同人音声5軸）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workName", "scores"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
  "description": "同人5軸レーダー用。グラフ評価内訳の評価要因は docs/シチュボイス五軸評価定義.md（シナリオ4要因・他軸2要因）。subScores は自動代理採点用（旧十サブ）で任意。"
    },
    "workName": { "type": "string", "minLength": 1 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immersion", "scenario", "pleasure", "acoustic", "satisfaction"],
      "properties": {
        "immersion": { "type": "number", "minimum": 0, "maximum": 10, "description": "没入度" },
        "scenario": { "type": "number", "minimum": 0, "maximum": 10, "description": "シナリオ" },
        "pleasure": { "type": "number", "minimum": 0, "maximum": 10, "description": "快楽度" },
        "acoustic": { "type": "number", "minimum": 0, "maximum": 10, "description": "音響" },
        "satisfaction": { "type": "number", "minimum": 0, "maximum": 10, "description": "満足度" }
      }
    },
    "radarAxisLabels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "immersion": { "type": "string" },
        "scenario": { "type": "string" },
        "pleasure": { "type": "string" },
        "acoustic": { "type": "string" },
        "satisfaction": { "type": "string" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subScores": {
      "type": "object",
      "description": "十サブ代理採点（score-graph-features.auto.json と同期）",
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "type": "object",
          "properties": {
            "reality": { "type": "number", "minimum": 0, "maximum": 10 },
            "inevitability": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "acoustic": {
          "type": "object",
          "properties": {
            "recording": { "type": "number", "minimum": 0, "maximum": 10 },
            "environment": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "immersion": {
          "type": "object",
          "properties": {
            "spatial": { "type": "number", "minimum": 0, "maximum": 10 },
            "distance": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "pleasure": {
          "type": "object",
          "properties": {
            "acting": { "type": "number", "minimum": 0, "maximum": 10 },
            "tempo": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "satisfaction": {
          "type": "object",
          "properties": {
            "concept": { "type": "number", "minimum": 0, "maximum": 10 },
            "yoin": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        }
      }
    },
    "scoreMeta": {
      "type": "object",
      "properties": {
        "computedAt": { "type": "string" },
        "method": { "type": "string" },
        "listenFree": { "type": "boolean" },
        "whisperReliability": { "type": "number" },
        "confidence": { "type": "object" }
      }
    }
  }
}
